{
  "name": "mylib",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./transport/client/default": {
      "types": "./dist/transport/client/default/index.d.ts",
      "import": "./dist/transport/client/default/index.mjs",
      "require": "./dist/transport/client/default/index.cjs"
    },
    "./transport/server/default": {
      "types": "./dist/transport/server/default/index.d.ts",
      "import": "./dist/transport/server/default/index.mjs",
      "require": "./dist/transport/server/default/index.cjs"
    }
  },
  "scripts": {
    "build:ts": "tsc --p ./tsconfig.json",
    "build:vite:node": "vite build --config vite.node.config.js",
    "build:vite:browser": "vite build --config vite.browser.config.js",
    "build": "npm run build:ts; npm run build:vite:node; npm run build:vite:browser",
    "start": "npm run build; cd example; npm run build"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "globals": "17.4.0",
    "rollup-plugin-node-externals": "8.1.2",
    "vite": "7.3.1",
    "vite-plugin-dts": "4.5.4"
  },
  "dependencies": {
    "typescript": "5.8.2"
  }
}
