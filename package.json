{
  "name": "fulgence",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./default-tasks-lifecycle": {
      "types": "./dist/tasks-lifecycle/default/index.d.ts",
      "import": "./dist/tasks-lifecycle/default/index.mjs",
      "require": "./dist/tasks-lifecycle/default/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    },
    "./transport/client/default": {
      "types": "./dist/transport/client/default/index.d.ts",
      "import": "./dist/transport/client/default/index.mjs",
      "require": "./dist/transport/client/default/index.cjs"
    },
    "./transport/server/default": {
      "types": "./dist/transport/server/default/index.d.ts",
      "import": "./dist/transport/server/default/index.mjs",
      "require": "./dist/transport/server/default/index.cjs"
    }
  },
  "scripts": {
    "build:ts": "tsc --p ./tsconfig.json",
    "build:vite:postbuild": "node ./bin/fix-ts-paths.js",
    "build:vite": "vite build --config vite.node.config.js && vite build --config vite.browser.config.js",
    "build": "npm run build:ts; npm run build:vite; npm run build:vite:postbuild;",
    "lint": "eslint .",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "prepublishOnly": "npm run build",
    "test": "npx vitest"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "npx eslint"
    ]
  },
  "author": "Anis SAJED",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "recursive-readdir": "^2.2.3",
    "replace": "^1.2.2",
    "rollup-plugin-node-externals": "^8.1.2",
    "testcontainers": "^11.12.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
