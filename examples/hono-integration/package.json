{
  "name": "hono",
  "type": "module",
  "scripts": {
    "cleanup": "sh ./bin/set-fulgence-symlink.sh",
    "dev": "tsx watch src/index.ts",
    "copy-files": "copyfiles -u 1 src/**/*.json dist",
    "build": "tsc",
    "postbuild": "npm run copy-files",
    "start": "npm run cleanup; node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "fulgence": "file:../..",
    "hono": "^4.12.16"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "copyfiles": "^2.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
